      { "fg": "content/link",           "bg": "surface/raised",          "min": 4.5, "why": "Enlace en card" },
      { "fg": "accent/on-subtle",       "bg": "accent/subtle",           "min": 4.5, "why": "Texto en pildora de acento" },
      { "fg": "accent/default",         "bg": "surface/keyboard",        "min": 3.0, "why": "Ancla activa: es superficie/icono, minimo de no-texto" },
      { "fg": "feedback/error-on-subtle",   "bg": "feedback/error-subtle",   "min": 4.5, "why": "Texto en pildora de error" },
