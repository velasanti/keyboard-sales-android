      { "fg": "feedback/success-on-subtle", "bg": "feedback/success-subtle", "min": 4.5, "why": "Texto en pildora de exito" },
      { "fg": "feedback/info-on-subtle",    "bg": "feedback/info-subtle",    "min": 4.5, "why": "Texto en pildora informativa" },
      { "fg": "content/on-error",       "bg": "feedback/error-solid",    "min": 4.5, "why": "Texto del boton destructivo. El unico relleno de feedback que lleva texto" },
      { "fg": "border/focus",           "bg": "surface/app",             "min": 3.0, "why": "Anillo de foco sobre fondo de app" },
      { "fg": "border/focus",           "bg": "surface/keyboard",        "min": 3.0, "why": "Anillo de foco dentro del teclado" },
      { "fg": "border/focus",           "bg": "surface/raised",          "min": 3.0, "why": "Anillo de foco sobre card" },
      { "fg": "border/strong",          "bg": "surface/raised",          "min": 3.0, "why": "Borde de input en reposo" },
      { "fg": "key/letter/bg",          "bg": "surface/keyboard",        "min": 1.25, "why": "Tecla de letra vs fondo. NO son 3:1 y no deberian serlo: ver nota keySeparation" },
      { "fg": "key/modifier/bg",        "bg": "surface/keyboard",        "min": 1.20, "why": "Modificadora vs fondo. Ordenada al lado opuesto de la letra" },
      { "fg": "key/letter/bg",          "bg": "key/modifier/bg",         "min": 1.25, "why": "Letra vs modificadora: es la distincion que el vendedor usa para no borrar sin querer" }
    ],
    "keySeparation": {
      "$comment": "Por que la tecla NO exige 3:1 contra el fondo del teclado.",
      "regla": "WCAG 1.4.11 pide 3:1 en los limites que hacen falta para IDENTIFICAR un componente. A una tecla la identifica su glifo, y el glifo cumple 4.5:1 contra su propio relleno.",
      "mercado": "Ningun teclado del mercado llega a 3:1 aca: el de iOS logra ~1.33 y Gboard en claro ~1.14. Un teclado con 3:1 entre tecla y fondo no se ve accesible, se ve roto.",
      "compromiso": "Se exige 1.25 (mejor que Gboard, a la par de iOS), el glifo a 4.5:1, y el orden de luminancia opuesto entre letra y modificadora para que las dos se separen del fondo en direcciones distintas.",
      "pendiente": "Falta una variante de alto contraste que agregue borde de 1dp a la tecla cuando el sistema pide contraste aumentado. Sin disenar."
    },
    "exempt": ["content/disabled", "accent/disabled", "surface/scrim", "state/pressed", "surface/track", "surface/placeholder"]
  }
}
